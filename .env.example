# TripPilot currently requires no secrets. These values document safe local
# defaults for the future FastAPI application; copy to .env only when needed.
TRIPPILOT_ENV=development
TRIPPILOT_LOG_LEVEL=INFO
TRIPPILOT_MOCK_DATA_PATH=data/mock

# Reserved for later milestones; leave unset during the mock-data MVP.
# DATABASE_URL=postgresql://user:password@localhost:5432/trippilot
# LLM_API_KEY=
