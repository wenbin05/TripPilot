# TripPilot currently requires no secrets. These values document safe local
# defaults for the future FastAPI application; copy to .env only when needed.
TRIPPILOT_ENV=development
TRIPPILOT_LOG_LEVEL=INFO
TRIPPILOT_MOCK_DATA_PATH=data/mock
# Comma-separated, explicit browser origins for local development only.
TRIPPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public browser configuration; create frontend/.env.local from this value.
NEXT_PUBLIC_TRIPPILOT_API_BASE_URL=http://127.0.0.1:8000

# Optional local coordinator experiment. It remains off unless all three values
# are set exactly; the API otherwise uses its deterministic fallback.
TRIPPILOT_COORDINATOR_ENABLED=false
TRIPPILOT_COORDINATOR_MODEL=gpt-5.6-terra
# TRIPPILOT_OPENAI_API_KEY=

# Reserved for later milestones; leave unset during the mock-data MVP.
# DATABASE_URL=postgresql://user:password@localhost:5432/trippilot
